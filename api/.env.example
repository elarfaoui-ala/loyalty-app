# Cloud Postgres connection string. Replace with your provider's URL.
# The ?sslmode=require suffix is required by most cloud providers
# (Neon, Supabase, Render, RDS ...).
#
# Neon:      postgresql://<user>:<password>@ep-<project>.aws.neon.tech/<db>?sslmode=require
# Supabase:  postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Render:    postgresql://<user>:<password>@<host>:5432/<db>?sslmode=require
#
# Then apply the schema (no Docker needed):
#   npx prisma migrate deploy
DATABASE_URL="postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:5432/CHANGE_ME_DB?sslmode=require&schema=public"
PORT=3000
NODE_ENV=development

# All three secrets MUST be unique random values (>= 24 chars) in production.
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="dev-only-access-secret-0123456789"
JWT_REFRESH_SECRET="dev-only-refresh-secret-0123456789"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

OTP_TTL_SECONDS=300
CUSTOMER_TOKEN_SECRET="dev-only-customer-secret-0123456789"
CUSTOMER_TOKEN_TTL="1h"

# OTP delivery: set a Resend API key (https://resend.com) to email codes.
# Without it, codes are printed to the API log (local dev fallback).
# You must verify your sending domain in Resend before customers receive mail.
RESEND_API_KEY=
MAIL_FROM="Loyalty <onboarding@resend.dev>"

# Comma-separated list of allowed origins. Required in production (no '*').
CORS_ORIGIN="*"

# Set to 1 to allow placeholder dev secrets outside production (local dev).
ALLOW_INSECURE_DEV=1