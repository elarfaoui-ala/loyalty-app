# Production environment template. Copy to `.env` and fill in real values.
#   cp .env.prod.example .env
#   docker compose -f docker-compose.prod.yml up -d --build

# --- Database ---
# Either use the bundled PostgreSQL service (set a strong POSTGRES_PASSWORD) or
# point DATABASE_URL at a managed Postgres (Neon, Supabase, RDS, ...).
POSTGRES_USER=loyalty
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=loyalty
# DATABASE_URL=postgresql://loyalty:CHANGE_ME@postgres:5432/loyalty?schema=public

# --- JWT secrets (REQUIRED, must be unique, >= 24 chars) ---
# Generate each with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CUSTOMER_TOKEN_SECRET=

# --- Token lifetimes (optional) ---
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=30d
# CUSTOMER_TOKEN_TTL=1h
# OTP_TTL_SECONDS=300

# --- OTP email delivery (optional) ---
# Without RESEND_API_KEY, codes are printed to the API log.
# RESEND_API_KEY=
# MAIL_FROM=Loyalty <onboarding@resend.dev>

# --- CORS (REQUIRED in production, no wildcard) ---
# Origins that may call the API directly, comma-separated — typically your
# widget site(s) and any other frontend that is NOT served through the
# dashboard's same-origin /api proxy.
CORS_ORIGIN=

# --- Host ports (optional) ---
# API_PORT=3000
# DASHBOARD_PORT=8080
